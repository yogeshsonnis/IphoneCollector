<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IphoneCollector.MVVM.View.CollectionViewUC.FTPView">
    <StackLayout Orientation="Vertical" Spacing="10" Margin="18" >
        <Label Text="FTP" FontSize="16" FontAttributes="Bold" HeightRequest="50" VerticalTextAlignment="Center" />
        <Entry  WidthRequest="551" Placeholder="Server URL" PlaceholderColor="#757574"/>
        <Entry  WidthRequest="551" Placeholder="Username" PlaceholderColor="#757574"/>
        <Button WidthRequest="121.5" HeightRequest="28" Background="#4daf50" Text="Test Connection" TextColor="White" HorizontalOptions="Start" />
        <Entry  WidthRequest="551" Placeholder="Save Lable To Address Book" PlaceholderColor="#757574"/>
        <Button HeightRequest="30" WidthRequest="62" Style="{StaticResource NotesBtn}" Background="#efefee" Text="Save" TextColor="Black"  HorizontalOptions="Start" FontSize="14"/>
    </StackLayout>
</ContentView>
