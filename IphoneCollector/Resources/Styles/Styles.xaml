    <!-- 🔘 Button Style -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>
  
    <!-- 📦 Panel Container -->
    <Style x:Key="PanelContainer" TargetType="StackLayout">
        <Setter Property="Padding" Value="24" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <!--<Setter Property="CornerRadius" Value="12" />-->
        <!--<Setter Property="Shadow" Value="True" />-->
    </Style>

    <!-- 📝 Text Entry Fields -->
    <Style x:Key="InputField" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="Margin" Value="0,4,0,12" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- 🔠 Labels -->
    <Style TargetType="Label" x:Key="FieldLabel">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,12,0,2" />
    </Style>

    <Style x:Key="MenuBarLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Padding" Value="18,5" />
        <Setter Property="MinimumWidthRequest" Value="120"/>
        <Setter Property="LineBreakMode" Value="WordWrap"/>
    </Style>
    
