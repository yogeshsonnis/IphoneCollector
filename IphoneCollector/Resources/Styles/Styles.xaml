    <Style x:Key="BtnStyle3" TargetType="Button">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HeightRequest" Value="35"/>
        <Setter Property="WidthRequest" Value="77.5"/>
        <Setter Property="CornerRadius" Value="5"/>
