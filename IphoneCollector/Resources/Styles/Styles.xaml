    <Style x:Key="RadioButtonAsButtonStyle" TargetType="RadioButton">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="HeightRequest" Value="38"/>
        <Setter Property="WidthRequest" Value="168"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
        <Setter Property="BackgroundColor" Value="#f2f2f2"/>
        <Setter Property="TextColor" Value="Black"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="ControlTemplate">
            <ControlTemplate>
                <Border x:Name="border" 
                    Background="{TemplateBinding BackgroundColor}"
                    Margin="{TemplateBinding Padding}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{TemplateBinding CornerRadius}" />
                    </Border.StrokeShape>
                    <Label Text="{TemplateBinding Content}"  
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       FontSize="{TemplateBinding FontSize}"    
                       FontAttributes="{TemplateBinding FontAttributes}"
                       TextColor="{TemplateBinding TextColor}"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style.Triggers>
            <!-- Trigger when checked -->
            <Trigger TargetType="RadioButton" Property="IsChecked" Value="True">
                <Setter Property="BackgroundColor" Value="#1e88e4"/>
                <Setter Property="TextColor" Value="#FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
